  "zm-meminfo": [
    "powershell",
    "-NoProfile",
    "-Command",
    "'PC RAM GB: ' + [math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB,1); 'docker MemTotal GB: ' + [math]::Round([double](docker info --format '{{.MemTotal}}')/1GB,1); 'CPU: ' + (Get-CimInstance Win32_Processor | Measure-Object -Property NumberOfLogicalProcessors -Sum).Sum; if (Test-Path $env:USERPROFILE\\.wslconfig) { 'wslconfig:'; Get-Content $env:USERPROFILE\\.wslconfig } else { 'wslconfig 없음' }"
  ],
