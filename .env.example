# ============================================================
#  Teomoony - 설정
#  이 파일을 .env 로 복사해서 값을 채우세요.
#  ※ .env 는 절대 git 에 올리지 말 것 (.gitignore 에 등록됨)
# ============================================================

# ------------------------------------------------------------
# DB (로컬 Docker SQL Server) — 필수
#   DB_PASSWORD 가 컨테이너 sa 비밀번호가 된다 (docker-compose.yml)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=11433
DB_USER=sa
DB_PASSWORD=
DB_NAME=Teomoony

# ------------------------------------------------------------
# 공공데이터포털   https://www.data.go.kr — 필수
#   건축물대장(건축HUB) · 실거래가 · 건축인허가 · K-apt · 청약홈 · 심평원
#   키 종류 : 일반 인증키 (Decoding). API 마다 별도 "활용신청" 승인 필요
# ------------------------------------------------------------
DATA_GO_KR_KEY=

# ------------------------------------------------------------
# 브이월드 (VWorld)   https://www.vworld.kr — 필수
#   연속지적도 · 건물 외곽선 · 법정동 경계 · 용도지역
#   키 발급 시 등록한 도메인에서만 동작할 수 있다
# ------------------------------------------------------------
VWORLD_KEY=
VWORLD_DOMAIN=localhost
# 국가중점데이터(NED) — 토지특성 · 토지이용계획 · 공동주택가격
VWORLD_NED_KEY=

# ------------------------------------------------------------
# 선택 — 키가 없으면 그 적재기만 돌지 않는다
# ------------------------------------------------------------
# 유치원알리미   https://e-childschoolinfo.moe.go.kr
KINDER_KEY=
# 나이스 교육정보 개방포털   https://open.neis.go.kr
NEIS_KEY=
# 보육정보공개(어린이집)   https://info.childcare.go.kr
CHILDCARE_KEY=
# 소상공인 상가(상권)정보
SEMAS_KEY=
# 서울 열린데이터광장   https://data.seoul.go.kr
SEOUL_OPENAPI_KEY=
# 통계청 SGIS (행정동 경계)
SGIS_KEY=
SGIS_SECRET=
# 도로명주소 개발자센터 — 현재 미사용
JUSO_KEY=

# 긴 적재가 끝났을 때 카카오톡 알림 (선택)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=
